[Unit]
Description=Black-Mata ngrok Tunnel
After=network-online.target black-mata-dashboard.service
Wants=network-online.target black-mata-dashboard.service

[Service]
Type=simple
User=__USER__
ExecStart=/usr/local/bin/ngrok http 8082
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
